{
  "name": "hajimink",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts --config config.dev.json --data-dir .local/dev",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsup --config tsup.config.ts && node scripts/copy-cli-helper.cjs dist-server",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "diagnose": "tsx scripts/diagnose.ts",
    "preview:dsh": "tsx scripts/preview-dsh.ts",
    "check": "tsc --noEmit",
    "check:release": "node scripts/check-release.mjs",
    "check:desktop-release": "node scripts/check-desktop-release.mjs",
    "package:source": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Package-Source.ps1",
    "diagrams": "node scripts/render-diagrams.mjs",
    "desktop": "electron .",
    "test:desktop": "node scripts/test-desktop.cjs",
    "test:device-ui": "tsx scripts/test-device-ui.ts",
    "test:stream-ui": "tsx scripts/test-stream-ui.ts",
    "test:workspace-ui": "tsx scripts/test-workspace-ui.ts",
    "test:desktop:sidebar": "tsx scripts/test-desktop-sidebar.ts",
    "test:desktop:upgrade": "node scripts/test-desktop-upgrade.cjs",
    "package:desktop:win": "npm run prepare:desktop:win && electron-builder --config desktop-builder.json --win --x64 --publish never && node scripts/write-desktop-checksums.cjs",
    "build:desktop:fixture": "vite build --outDir .local/hajimink-stage/dist && tsup --config tsup.config.ts --out-dir .local/hajimink-stage/dist-server && node scripts/copy-cli-helper.cjs .local/hajimink-stage/dist-server && node scripts/build-desktop-controller.cjs",
    "test:desktop:gateway": "node scripts/test-desktop-gateway.cjs",
    "test:gateway-manager": "node scripts/test-gateway-manager.cjs",
    "test:port-change": "node scripts/test-port-change.cjs",
    "test:owner-setup": "node scripts/test-owner-setup.cjs",
    "test:passkey-setup": "node scripts/test-passkey-setup.cjs",
    "test:desktop:packaged": "node scripts/test-packaged-desktop.cjs",
    "prepare:desktop:win": "node node_modules/electron/install.js && npm run build:desktop:fixture && node scripts/prepare-desktop-runtime.cjs",
    "package:desktop:win:dir": "npm run prepare:desktop:win && electron-builder --config desktop-builder.json --win --x64 --dir --publish never",
    "test:private-control": "node scripts/test-private-control.cjs",
    "test:bridge-disconnect": "node scripts/test-bridge-disconnect.cjs",
    "test:exit-coordinator": "node scripts/test-exit-coordinator.cjs",
    "test:exit-recovery": "node scripts/test-exit-recovery.cjs",
    "test:gateway-intent": "node scripts/test-gateway-intent.cjs",
    "test:desktop:intent": "node scripts/test-desktop-intent.cjs",
    "test:desktop:exit": "node scripts/test-desktop-exit.cjs",
    "test:controller": "node scripts/test-controller.cjs",
    "test:desktop:controller": "node scripts/test-desktop-controller.cjs",
    "test:tunnel-manager": "node scripts/test-tunnel-manager.cjs",
    "test:natapp-manager": "node scripts/test-natapp-manager.cjs",
    "test:natapp-controller": "node scripts/test-natapp-controller.cjs",
    "test:natapp-ui": "node scripts/test-desktop-natapp.cjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11",
    "@simplewebauthn/server": "^14.0.3",
    "fastify": "^5",
    "immer": "^11",
    "jose": "^6",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8",
    "@vitejs/plugin-react": "^5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "js-yaml": "4.3.2",
    "lucide-react": "^0.468",
    "playwright": "^1.56",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10",
    "remark-gfm": "^4",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5.9",
    "vite": "^7",
    "vitest": "^5.0.5"
  },
  "description": "HajiMink desktop workspace and private gateway for existing Agent sessions",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "overrides": {
    "@fastify/static": {
      "glob": "^14.0.3"
    },
    "minimatch@^10.2.5": "^11.0.3"
  }
}
